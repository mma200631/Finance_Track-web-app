<%- include('../partials/header') %>

<main class="transactions-page">

    <section class="transactions-heading">

        <div>
            <p class="welcome-text">FINANCIAL ACTIVITY</p>
            <h1>Transactions</h1>
            <p>View and manage all your income and expenses.</p>
        </div>

        <a href="/transactions/new" class="btn">
            + Add Transaction
        </a>

    </section>


    <section class="transactions-card">

        <% if (transactions.length > 0) { %>

            <div class="transactions-table-wrapper">

                <table class="transactions-table">

                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% transactions.forEach(transaction => { %>

                            <tr>

                                <td class="transaction-description">
                                    <%= transaction.description %>
                                </td>

                                <td class="transaction-amount">
                                    ₦<%= Number(transaction.amount).toFixed(2) %>
                                </td>

                                <td>
                                    <span class="<%= transaction.transaction_type === 'Income' ? 'income-badge' : 'expense-badge' %>">
                                        <%= transaction.transaction_type %>
                                    </span>
                                </td>

                                <td>
                                    <%= transaction.category_name %>
                                </td>

                                <td>
                                    <%= new Date(transaction.transaction_date).toLocaleDateString() %>
                                </td>

                                <td class="transaction-actions">

                                    <a
                                        href="/transactions/<%= transaction.transaction_id %>/edit"
                                        class="edit-btn"
                                    >
                                        Edit
                                    </a>

                                    <form
                                        action="/transactions/<%= transaction.transaction_id %>/delete"
                                        method="POST"
                                    >
                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >
                                            Delete
                                        </button>
                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-transactions">

                <div class="empty-icon">₦</div>

                <h2>No Transactions Yet</h2>

                <p>
                    Start tracking your finances by adding your first transaction.
                </p>

                <a href="/transactions/new" class="btn">
                    + Add Your First Transaction
                </a>

            </div>

        <% } %>

    </section>

</main>

<%- include('../partials/footer') %>